<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>FullScreen</key><true/>
			<key>Icon</key><data></data>
			<key>IsRemovable</key><true/>
			<key>Label</key><string>Lumio</string>
			<key>Precomposed</key><true/>
			<key>URL</key><string>https://lumiotv.github.io/</string>
			<key>PayloadDescription</key><string>Adds Lumio to your Home Screen</string>
			<key>PayloadDisplayName</key><string>Lumio app</string>
			<key>PayloadIdentifier</key><string>com.lumio.web.clip</string>
			<key>PayloadType</key><string>com.apple.webClip.managed</string>
			<key>PayloadUUID</key><string>B62A127C-1769-52AF-AAA8-FED4A25406CB</string>
			<key>PayloadVersion</key><integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key><string>Installs Lumio on your Home Screen as a full-screen app. Nothing else on your iPhone is changed. Remove it any time in Settings → General → VPN &amp; Device Management.</string>
	<key>PayloadDisplayName</key><string>Lumio</string>
	<key>PayloadIdentifier</key><string>com.lumio.web</string>
	<key>PayloadOrganization</key><string>Lumio</string>
	<key>PayloadRemovalDisallowed</key><false/>
	<key>PayloadType</key><string>Configuration</string>
	<key>PayloadUUID</key><string>9DBCE9DC-3677-5A70-A3FE-F4B96EC82879</string>
	<key>PayloadVersion</key><integer>1</integer>
</dict>
</plist>
